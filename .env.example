# Environment Variables
# Set these in Vercel under Project → Settings → Environment Variables.
# Anything prefixed with VITE_ is baked into the public client bundle,
# so never put secrets here.

# Cloudflare R2 Configuration
VITE_R2_BUCKET_NAME=your_bucket_name
VITE_R2_PUBLIC_URL=https://cdn.isthishenry.com

# Claude API key for the site assistant (api/ask.js). Server-only: no VITE_
# prefix, so it never reaches the browser. Add it in Vercel as a Sensitive
# variable; for `npm run dev`, put it in .env.local.
ANTHROPIC_API_KEY=your_anthropic_api_key

# ── Site editor at /crm ──
# All server-only (no VITE_ prefix). Add them in Vercel as Sensitive variables;
# for `npm run dev`, put them in .env.local.

# Sign-in: one password, plus a random secret (32+ characters) that signs the
# session cookie. Generate the secret with: openssl rand -hex 32
# Changing either signs everyone out.
CRM_PASSWORD=choose_a_long_password
CRM_SESSION_SECRET=output_of_openssl_rand_hex_32

# Supabase holds the site's content (supabase/schema.sql). From the project's
# Settings → API Keys: the project URL and a secret key (sb_secret_…).
# Without these, `npm run dev` saves to .crm-local/ instead.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_key

# Uploads go straight from the editor to R2. Cloudflare → R2 → Manage API
# tokens: create one with Object Read & Write on the bucket.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# Optional: defaults to isthishenry
# R2_BUCKET=isthishenry
